{
  "name": "dsh-subagent-ctx",
  "version": "0.1.1",
  "description": "在一次性子代理 composer 位实时显示 ctx（含 think）和 tps，替换只读废话条",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": { "default": "./index.js" },
    "./client": { "default": "./client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
